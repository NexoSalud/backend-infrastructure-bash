###############################################################
# NexoSalud – Variables de entorno para Portainer
#
# Instrucciones:
#   1. Stacks → Add Stack → Repository o Upload
#   2. Pegar estas variables en "Environment variables"
###############################################################

# ── Versión de deploy (incrementar para forzar rebuild) ───────
# Cambiar este número cada vez que se quiera forzar reconstrucción
# de todas las imágenes sin cache.
DEPLOY_VERSION=1

# ── GitHub Token (REQUERIDO para repos privados) ──────────────
# Generar en: github.com/settings/tokens → Generate new token (classic)
# Scopes necesarios: repo (lectura completa de repos privados)
# El token se usa SOLO durante el build para clonar el código.
# No queda expuesto en los contenedores en ejecución.
GH_TOKEN=ghp_****************************

# ── Base de datos ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=nexosalud
POSTGRES_HOST_PORT=5432

# ── Spring ────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Seguridad ─────────────────────────────────────────────────
JWT_SECRET=mySecretKeyForJWTTokenGenerationAndValidation1234567890
AUTH_MOCK_MODE=false

# ── Gateway ───────────────────────────────────────────────────
GATEWAY_HOST_PORT=8080

# ── Email ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=no-reply@nexosalud.com
EMAIL_PASSWORD=app_password_aqui
EMAIL_FROM=no-reply@nexosalud.com
EMAIL_RESET_PASSWORD_SUBJECT=Recuperación de contraseña NexoSalud
EMAIL_RESET_PASSWORD_TEXT=Para restablecer su contraseña haga clic en el siguiente enlace:
EMAIL_RESET_PASSWORD_WEBSITE=https://app.nexosalud.com/reset-password

# ── Appointments ──────────────────────────────────────────────
APPOINTMENT_DEFAULT_DURATION=20
VALIDATION_MOCK_MODE=true
